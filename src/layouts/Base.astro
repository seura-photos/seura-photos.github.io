---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';

interface Props {
  title?: string;           // page title; the site name is appended
  fullTitle?: string;       // or a complete title, used as is
  description?: string;
  image?: string;           // social card path under /og/, without .png
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = SITE_DESCRIPTION,
  image = 'home',
  imageAlt = 'The Seura Photos icon, a sun of warm dots over a horizon of cool ones, beside the page title.',
  type = 'website',
  published,
  jsonLd = [],
} = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} · ${SITE_TITLE}` : SITE_TITLE);
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`/og/${image}.png`, Astro.site);
const path = Astro.url.pathname;
const structured = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, url: new URL('/', Astro.site).href },
  ...jsonLd,
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="Seura Photos devlog" href={new URL('/devlog/rss.xml', Astro.site)}>
  <meta property="og:site_name" content={SITE_TITLE}>
  <meta property="og:title" content={title ?? fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={imageAlt}>
  {published && <meta property="article:published_time" content={published.toISOString()}>}
  <meta name="twitter:card" content="summary_large_image">
  {structured.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container bar">
      <a class="brand" href="/" aria-label="Seura Photos, home">
        <img src="/mark-small.svg" width="28" height="28" alt="">
        <span>Seura <span class="light">Photos</span></span>
      </a>
      <nav aria-label="Site">
        <a href="/devlog/" aria-current={path.startsWith('/devlog') ? 'page' : undefined}>Devlog</a>
        <a href={GITHUB_URL}>GitHub</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>Seura Photos is free and open source under the Apache 2.0 license. This site has no tracking, no cookies, and no ads.</p>
      <p>Devlog posts and images are licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>: share and adapt them with credit to Nevada Hamaker and a link back. The Seura Photos name and icon are not covered by this license.</p>
      <p><a href="/devlog/rss.xml">Devlog RSS feed</a> · <a href={GITHUB_URL}>Source on GitHub</a></p>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--text); font-family: var(--font-brand); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; }
  .brand .light { font-weight: 400; color: var(--text-2); }
  nav { display: flex; gap: 0.25rem; }
  nav a { color: var(--text); text-decoration: none; padding: 0.5rem 0.75rem; border-radius: 6px; }
  nav a:hover { background: var(--panel); }
  nav a[aria-current='page'] { background: var(--accent-subtle); }
  main { padding: 3rem 0 4rem; }
  .site-footer { border-top: 1px solid var(--border); color: var(--text-2); font-size: 0.9rem; padding: 1.5rem 0 2.5rem; }
  .site-footer p { margin: 0.4rem 0; }
</style>
